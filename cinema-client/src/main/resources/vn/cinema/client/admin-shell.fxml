<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.cinema.client.controller.AdminShellController" styleClass="page">
 <top>
  <VBox spacing="10" styleClass="admin-header">
   <HBox spacing="18" alignment="CENTER_LEFT">
    <VBox spacing="5">
     <Label text="NOIR / QUẢN TRỊ RẠP" styleClass="brand"/>
     <Label text="Điều hành rạp phim" styleClass="admin-title"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <VBox spacing="6" alignment="CENTER_RIGHT">
     <Label fx:id="identity" styleClass="light-text"/>
     <Label fx:id="connection" styleClass="light-text"/>
    </VBox>
    <Button text="Tài khoản quản trị" onAction="#profile"/>
    <Button text="Đăng xuất" onAction="#logout"/>
   </HBox>
   <Label fx:id="notice" text="Quản lý phim, phòng, lịch chiếu, ghế, khách hàng, đơn đặt và vé." wrapText="true" styleClass="light-text"/>
  </VBox>
 </top>
 <center>
  <VBox styleClass="admin-workspace">
   <fx:include fx:id="management" source="admin.fxml" VBox.vgrow="ALWAYS"/>
  </VBox>
 </center>
 <bottom>
  <Label text="NOIR Cinema · Quản trị dữ liệu toàn rạp · Thanh toán mô phỏng" styleClass="admin-footer"/>
 </bottom>
</BorderPane>

