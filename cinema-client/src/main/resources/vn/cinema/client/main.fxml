<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.cinema.client.controller.MainController" styleClass="page">
 <top><VBox spacing="14" styleClass="user-header">
  <HBox alignment="CENTER_LEFT" spacing="22">
   <Label text="NOIR / CINEMA" styleClass="brand"/>
   <Label text="Hẹn nhau ở rạp" styleClass="muted"/>
   <Region HBox.hgrow="ALWAYS"/>
   <Label fx:id="userLabel" styleClass="light-text"/>
   <Label fx:id="connectionLabel" styleClass="legend-available"/>
   <Button text="Đăng xuất" onAction="#logout"/>
  </HBox>
  <HBox spacing="12">
   <Button text="Phim đang chiếu" onAction="#home" styleClass="nav-button"/>
   <Button text="Vé của tôi" onAction="#tickets" styleClass="nav-button"/>
   <Button text="Tài khoản" onAction="#account" styleClass="nav-button"/>
   <Region HBox.hgrow="ALWAYS"/><Label text="ĐẶT VÉ RẠP · TCP / LAN" styleClass="eyebrow"/>
  </HBox>
 </VBox></top>
 <center><BorderPane>
  <top><VBox spacing="5" styleClass="topbar"><Label fx:id="pageTitle" styleClass="page-title"/><Label fx:id="notice" wrapText="true" styleClass="muted"/></VBox></top>
  <center><VBox fx:id="content" spacing="16" styleClass="content"/></center>
 </BorderPane></center>
</BorderPane>
